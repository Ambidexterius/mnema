ARG MNEMONIO_RUNTIME_IMAGE
FROM node:24.15.0-bookworm-slim@sha256:4e6b70dd6cbfc88c8157ba19aa3d9f9cce6ba4703576d55459e45efcbc9c5f5d AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts --no-fund --no-audit
COPY app ./app
RUN npm run build && npm prune --omit=dev --ignore-scripts --no-fund --no-audit

# Amvera-specific recovery: retain the verified runtime (Node, Whisper, OCR).
# All application code below is replaced with 0.7.0. The portable, full-build
# Dockerfile remains in the public GitHub checkout.
FROM ${MNEMONIO_RUNTIME_IMAGE}
WORKDIR /app
COPY --from=build /app/package.json /tmp/mnemonio-next-package.json
RUN node -e "const fs=require('node:fs');const old=JSON.parse(fs.readFileSync('/app/package.json'));const next=JSON.parse(fs.readFileSync('/tmp/mnemonio-next-package.json'));if(JSON.stringify(old.dependencies)!==JSON.stringify(next.dependencies))throw new Error('Runtime dependencies changed: use the full-build Dockerfile');" && rm -rf /app/public /app/server
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/dist ./public
COPY server ./server
COPY docker-entrypoint.sh ./docker-entrypoint.sh
RUN chmod 755 /app/docker-entrypoint.sh
ENV NODE_ENV=production PORT=3000 MNEMA_DATA_DIR=/data MNEMA_PUBLIC_DIR=/app/public ASR_MODEL_DIR=/app/models/whisper-small OCR_LANGUAGES=rus+eng HF_HUB_OFFLINE=1
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 CMD node -e "fetch('http://127.0.0.1:3000/healthz').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
ENTRYPOINT ["/app/docker-entrypoint.sh"]
